{
  "family": "hf_amplitude_classifier_family",
  "dataset": "cifar10",
  "classifier_mode": "amplitude",
  "checkpoint": false,
  "vae_backbone": {
    "strategy": "amplitude_vae",
    "amplitude_vae": {
      "vae_class": "QuantumVAEAmplitude",
      "checkpoint": "models/autoencoders/cifar10/autoencoderklcifar10.pt"
    }
  },
  "classifier": {
    "softmax": true,
    "num_labels": 10
  },
  "n_qubits": 7,
  "n_layers": 20,
  "num_labels": 10,
  "measurement": {
    "kind": "probability",
    "pauli": "Z"
  },
  "postprocessing_mlp": {
    "enabled": false,
    "hidden_dim": 128
  },
  "trainer": {
    "output_dir": "paperlogs/hf_amplitude_classifier",
    "logging_dir": "paperlogs/hf_amplitude_classifier/logs",
    "overwrite_output_dir": false,
    "logging_strategy": "steps",
    "logging_steps": 25,
    "save_strategy": "epoch",
    "save_total_limit": 2,
    "evaluation_strategy": "epoch",
    "load_best_model_at_end": true,
    "per_device_train_batch_size": 32,
    "per_device_eval_batch_size": 32,
    "learning_rate": 1e-4,
    "num_train_epochs": 1,
    "report_to": [
      "tensorboard"
    ]
  }
}
