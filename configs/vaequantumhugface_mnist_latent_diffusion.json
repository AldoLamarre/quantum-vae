{
  "family": "vaequantumhugface_mnist_latent_diffusion",
  "task_type": "latent_diffusion",
  "dataset": "mnist",
  "model_name": "euclidean",
  "base_checkpoint": "mnist_datareupload_compat",
  "base_model_config": "configs/paper/vaequantumhugface_mnist_pretraining_data_reupload11.json",
  "data": {
    "latents_cache": "diffusion_data/mnist_latents_option_a.pt",
    "batch_size": 256
  },
  "model": {
    "latent_dim": 196,
    "n_classes": 10,
    "hidden": 512,
    "n_timesteps": 1000,
    "latent_shape": [4, 7, 7]
  },
  "training": {
    "cfg_dropout_prob": 0.1,
    "num_train_epochs": 50,
    "learning_rate": 2e-4,
    "preview_every_n_epochs": 10,
    "preview_digit": 3,
    "preview_num_images": 8
  },
  "trainer": {
    "output_dir": "checkpoints/diffusion/vaequantumhugface_mnist_latent_diffusion",
    "logging_steps": 25,
    "save_strategy": "epoch",
    "save_total_limit": 2,
    "eval_strategy": "epoch"
  }
}
